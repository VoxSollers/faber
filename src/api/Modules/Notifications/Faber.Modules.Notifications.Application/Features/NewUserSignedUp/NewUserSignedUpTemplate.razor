<div>
    Someone has created new user for Faber.<br/>
    If this was you, click the link below to verify your email address.<br/>
    <br/>
    Click <a href="@Host/auth/verify-email?key=@Key">here</a> to verify email.<br/>
    <br/>
    If you didn't create this account, just ignore this message.
</div>

@code {

    [Parameter]
    public string? Host { get; set; }

    [Parameter]
    public string? Key { get; set; }

}