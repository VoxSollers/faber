# nginx configuration for the faber-app edge container (ghcr.io/1viski/faber-web).
#
# Ported from src/web/Faber.NgApp/faber-ngapp/nginx.conf (issue #429). This
# container is the edge for the whole deployment, not just a static-file server:
# it terminates TLS for the configured app domain and its keycloak/vault
# subdomains, proxies to the keycloak and vault containers, serves the
# Angular SPA, and owns maintenance mode.
#
# THIS FILE IS A TEMPLATE. The official nginx entrypoint renders it with envsubst
# into /etc/nginx/nginx.conf at container start. Substitution is restricted by
# NGINX_ENVSUBST_FILTER=^FABER_ so that nginx's own runtime variables ($host,
# $remote_addr, $uri, ...) survive untouched — without that filter envsubst would
# blank every one of them.
#
# Substituted variables:
#   ${FABER_API_UPSTREAM}  scheme://host:port of the Faber API container, as named
#                          by the external private production Compose file.
#                          Defaulted in the Dockerfile; override from that
#                          deployment configuration when the service is named
#                          something else.
#   ${FABER_APP_DOMAIN}    the production app domain (e.g. example.com). Used for
#                          server_name on the main site and its keycloak/vault
#                          subdomains. Defaulted in the Dockerfile; override from
#                          compose with the real domain.
#   ${FABER_MAINTENANCE_ALLOWED_IP}
#                          operator IP address that bypasses maintenance mode.
#                          Defaulted in the Dockerfile; override from compose.

worker_processes auto;
events {
    worker_connections 1024;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Basic security headers
    server_tokens off;

    # Performance optimizations
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 20M;

    # CHANGED vs. Faber.NgApp: Docker's embedded DNS.
    # Two reasons. (1) It lets the /api/ proxy below resolve its upstream lazily,
    # at request time, instead of at config load — so this container still starts
    # (and keeps terminating TLS for keycloak and vault) when the API container is
    # down or renamed. (2) ssl_stapling silently needs a resolver; without one it
    # logs "ssl_stapling ignored, no resolver defined" and does nothing.
    resolver 127.0.0.11 ipv6=off valid=30s;

    # SSL optimization
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_buffer_size 4k;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript
               application/x-javascript application/xml
               application/javascript application/json;
    gzip_disable "MSIE [1-6]\.";
    gzip_comp_level 6;

    # Rate limiting zones
    limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_conn_zone $binary_remote_addr zone=addr:10m;

    # Maintenance mode mapping
    map $remote_addr $maintenance_allowed {
        default 0;
        ${FABER_MAINTENANCE_ALLOWED_IP} 1;
    }

    # HTTP to HTTPS redirect
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name ${FABER_APP_DOMAIN} www.${FABER_APP_DOMAIN};

        # Redirect all HTTP requests to HTTPS
        return 301 https://$host$request_uri;
    }

    # HTTPS server
    server {
        # HTTP/2 is deliberately not enabled. The original config carried
        # commented-out `listen 443 ssl http2;` breadcrumbs; before acting on them,
        # note that the Content-Security-Policy below is written as a quoted string
        # with embedded newlines and is therefore emitted obs-folded across ~12
        # lines. That is legal HTTP/1.1, but HTTP/2 forbids newlines in header
        # values — enabling http2 without first flattening that header to one line
        # will break the CSP.
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name ${FABER_APP_DOMAIN} www.${FABER_APP_DOMAIN};

        # Maintenance mode logic
        set $maintenance_mode 0;
        if (-f /usr/share/nginx/html/maintenance/.maintenance_on) {
            set $maintenance_mode M;
        }
        if ($maintenance_allowed) {
            set $maintenance_mode 0;
        }
        if ($maintenance_mode = M) {
            return 503;
        }

        # SSL filenames are part of the private production deployment contract.
        ssl_certificate /etc/nginx/certs/microcivi_com_fullchain.crt;
        ssl_certificate_key /etc/nginx/certs/microcivi.com.key;
        ssl_trusted_certificate /etc/nginx/certs/microcivi_com.ca-bundle;

        # Modern SSL configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
        ssl_prefer_server_ciphers on;
        ssl_ecdh_curve secp384r1;

        # Root directory
        root /usr/share/nginx/html;
        index index.html;

        # CHANGED vs. Faber.NgApp: same-origin reverse proxy to the Faber API.
        # faber-app's src/environments/environment.prod.ts sets api: '/api/v1' —
        # a relative path — where NgApp used the absolute https://microcivi.com:7106.
        # Without this block every production API call 404s against the SPA.
        #
        # '^~' is load-bearing: it stops the static-asset regex location further
        # down from stealing API paths that happen to end in a cached extension.
        location ^~ /api/ {
            limit_req zone=api burst=40 nodelay;
            limit_conn addr 20;

            # A variable proxy_pass defers DNS to request time (see the resolver
            # above). The cost is that it no longer inherits the location's URI
            # rewriting, so $request_uri has to be appended by hand.
            set $api_upstream "${FABER_API_UPSTREAM}";
            proxy_pass $api_upstream$request_uri;

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Resume PDF generation drives a headless browser; give it room.
            proxy_connect_timeout 15s;
            proxy_send_timeout 120s;
            proxy_read_timeout 120s;

            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
        }

        # Angular SPA handling
        location / {
            # Apply rate limiting
            limit_req zone=general burst=20 nodelay;
            limit_conn addr 10;

            try_files $uri $uri/ /index.html;

            # Security headers
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-XSS-Protection "1; mode=block" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;

            # CHANGED vs. Faber.NgApp: CSP retuned for faber-app.
            #  - style-src gains https://fonts.googleapis.com. src/index.html pulls
            #    two Google Fonts stylesheets; the old policy would block both.
            #  - the separate script-src-elem directive is gone. It listed 'self'
            #    without 'unsafe-inline', and because script-src-elem overrides
            #    script-src for <script> elements it would have blocked the inline
            #    theme-bootstrap script in src/index.html.
            #  - https://cdn.jsdelivr.net dropped from script-src: faber-app loads
            #    nothing from a CDN.
            #  - connect-src tightened to 'self' now that /api/ is same-origin, and
            #    keycloak/vault dropped from connect-src and frame-src: the browser
            #    never talks to either directly, only the API does.
            #  - 'unsafe-eval' is retained deliberately. pdfjs-dist can fall back to
            #    eval for font rendering; a cutover is the wrong moment to find out.
            #    Tightening it is a follow-up, not part of this swap.
            add_header Content-Security-Policy "
            default-src 'self';
            base-uri 'self';
            form-action 'self';
            worker-src 'self' blob:;
            script-src 'self' 'unsafe-inline' 'unsafe-eval';
            style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
            font-src 'self' https://fonts.gstatic.com data:;
            img-src 'self' data: blob:;
            connect-src 'self' blob:;
            frame-src 'self';
            object-src 'none';" always;

            # Performance headers
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        # Cache static assets
        location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff2?)$ {
            expires 1y;
            access_log off;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Enhanced maintenance error page
        error_page 503 @maintenance;

        location @maintenance {
            root /usr/share/nginx/html;
            rewrite ^(.*)$ /maintenance/maintenance.html break;

            # Maintenance-specific headers
            add_header Retry-After 1800 always;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header X-Maintenance-Mode "active" always;

            # Security headers
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-XSS-Protection "1; mode=block" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:;" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        }
    }

    # Keycloak
    server {
        listen 443 ssl;
        server_name keycloak.${FABER_APP_DOMAIN};

        # SSL certificates (ensure these paths are accessible within the Nginx container)
        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        location / {
            # Rate limiting
            limit_req zone=api burst=30 nodelay;
            limit_conn addr 10;

            # Forward requests to the 'keycloak' service on port 8080
            proxy_pass http://keycloak:8080;

            # Standard proxy headers for preserving client information
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme; # Informs Keycloak that the original request was HTTPS

            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;

            # Optimization for Keycloak's large headers (tokens and cookies)
            proxy_buffer_size   128k;
            proxy_buffers   4 256k;
            proxy_busy_buffers_size   256k;
        }
    }

    # HashiCorp Vault
    server {
        listen 443 ssl;
        server_name vault.${FABER_APP_DOMAIN};

        # Use your existing certificates
        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        location / {
            # Rate limiting
            limit_req zone=api burst=30 nodelay;
            limit_conn addr 10;

            # Forward to the vault container on port 8200 with HTTPS
            proxy_pass https://vault:8200;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;

            # Vault uses WebSockets for some UI features
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
